TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
BASE_URL=http://127.0.0.1:8787

DATA_DIR=/data
INBOX_DIR=/media/inbox
OUTPUT_DIR=/media/output
AUTO_MATCH_LATEST=false
BURN_SUBTITLES=true

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto

TRANSLATION_BASE_URL=http://host.docker.internal:11434/v1
TRANSLATION_API_KEY=local
TRANSLATION_MODEL=qwen2.5:7b
# 每批翻译多少句字幕（接口每次调用有固定开销，批量大更省；50 句实测最稳）
TRANSLATION_BATCH=50
# 搜索结果里的种子标题是否翻译成中文（false 更快）
TRANSLATE_TITLES=true

# 搜索与下载
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
QBITTORRENT_URL=http://qbittorrent:8081
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
QBITTORRENT_DOWNLOAD_DIR=/downloads
DOWNLOAD_POLL_SECONDS=5
MAX_UPLOAD_GB=8
# 可选：GitHub 下载 ffmpeg 失败时，填一个可访问的同名 tar.xz 镜像地址
FFMPEG_URL=

# 成品自动归档到宿主机的这个目录（容器内挂载为 /archive）
ARCHIVE_HOST_DIR=D:/MediaDownloads

# 网页管理登录（留空表示不启用；暴露到局域网时强烈建议设置）
WEB_USERNAME=admin
WEB_PASSWORD=

# 宿主机代理（Clash 等）。Prowlarr 抓索引器、worker 访问 Telegram/翻译模型都走它；
# 容器之间（prowlarr/qbittorrent）互访不走代理。端口按你的代理软件实际监听端口改。
MEDIA_HTTP_PROXY=http://host.docker.internal:7897
MEDIA_HTTPS_PROXY=http://host.docker.internal:7897

STATION_SUBMIT_URL=
HOOK_TOKEN=
POLL_SECONDS=15
# 处理失败自动重试次数 / 间隔（秒）
PROCESS_RETRIES=2
PROCESS_RETRY_DELAY=180
# 完成后自动删除源文件（qBittorrent 任务 + inbox），省磁盘
AUTO_CLEAN=true
# 下载 15 分钟还没速度就自动换同片做种更多的版本
AUTO_SWITCH_SLOW=true

STATION_AUTH_USER=admin
STATION_AUTH_PASSWORD=change-me
